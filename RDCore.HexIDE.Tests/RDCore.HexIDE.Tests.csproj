<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyTitle>RDCore for HexIDE Tests</AssemblyTitle>
    <Description>The tests of the RDCore add-in for HexIDE.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.3.3" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <!-- HexIDE's, which the add-in compiles against only. -->
    <PackageReference Include="StreamJsonRpc" Version="$(HexIdeStreamJsonRpcVersion)" />
    <PackageReference Include="MessagePack" Version="$(HexIdeMessagePackVersion)" />
    <PackageReference Include="Nerdbank.MessagePack" Version="$(HexIdeNerdbankMessagePackVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDCore.HexIDE\RDCore.HexIDE.csproj" />
    <!-- the add-in ships no HexIDE.Core, since HexIDE has its own; its tests run without HexIDE, so they bring it. -->
    <ProjectReference Include="$(HexIdeCoreProject)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RDCore.PlatformInstaller.Tests\FakeGitHub.cs" Link="FakeGitHub.cs" />
    <Compile Include="..\RDCore.PlatformInstaller.Tests\TempFolders.cs" Link="TempFolders.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the RDCore.SDK version the add-in is built with, which the SDK stamps into the assemblies it loads. -->
    <AssemblyMetadata Include="RDCoreSdkVersion" Value="$(RDCoreSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
