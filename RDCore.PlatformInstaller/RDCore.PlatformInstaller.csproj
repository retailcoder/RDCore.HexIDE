<Project Sdk="Microsoft.NET.Sdk">

  <!-- gets the RDCore platform onto the machine: the .NET base library and RDCore.SDK, which reads a platform's manifests and
       holds its version rule, and nothing of HexIDE, so that it moves into RDCore's own installer as it is. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>RDCore.PlatformInstaller</RootNamespace>
    <AssemblyTitle>RDCore Platform Installer</AssemblyTitle>
    <Description>Finds, downloads, verifies and installs the RDCore platform on the machine.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RDCore.SDK" Version="$(RDCoreSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RDCore.PlatformInstaller.Tests" />
  </ItemGroup>

</Project>
