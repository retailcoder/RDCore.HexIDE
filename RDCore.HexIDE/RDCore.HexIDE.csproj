<Project Sdk="Microsoft.NET.Sdk">

  <!-- the add-in HexIDE loads: what it ships is copied beside it, and nothing HexIDE shares with its add-ins. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>RDCore.HexIDE</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- the add-in contract: HexIDE's own copy is the one loaded, so none ships with the add-in. -->
    <ProjectReference Include="$(HexIdeCoreProject)" Private="false" />
    <ProjectReference Include="$(RDCoreProtocolProject)" />
    <ProjectReference Include="..\RDCore.PlatformInstaller\RDCore.PlatformInstaller.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HexIDE's own Avalonia is the one loaded, for the same reason. -->
    <PackageReference Include="Avalonia" Version="$(HexIdeAvaloniaVersion)" ExcludeAssets="runtime" />
    <!-- HexIDE's own StreamJsonRpc is the one loaded too: an add-in assembly the package doesn't carry resolves to HexIDE's,
         so the LocalRpcException the add-in throws is the one HexIDE's connection knows. -->
    <PackageReference Include="StreamJsonRpc" Version="$(HexIdeStreamJsonRpcVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="MessagePack" Version="$(HexIdeMessagePackVersion)" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Nerdbank.MessagePack" Version="$(HexIdeNerdbankMessagePackVersion)" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RDCore.HexIDE.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
